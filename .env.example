# ===============================================
# VaultFlow Configuration
# ===============================================

# MongoDB Atlas or local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vaultflow?retryWrites=true&w=majority

# JWT signing secret (HMAC-SHA256, minimum 256 bits / 32 bytes)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=<generate with: openssl rand -hex 32>

# JWT token expiration in milliseconds (e.g., 604800000 = 7 days)
JWT_EXPIRATION_MS=604800000

# Backend server port (Default: 8080 for Spring Boot)
PORT=8080

# CORS allowed frontend origin (e.g., your Vercel URL or local dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-vaultflow.vercel.app

# Frontend API base URL (empty string for same-origin proxy, or backend server URL)
VITE_API_URL=http://localhost:8080
